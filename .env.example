# CONFIGURATION TEMPLATE ONLY - this file is never loaded by the application.
# Copy it to a file named .env, then replace the placeholder API key locally.
# The real .env file is ignored by Git. Never commit real credentials.

# Local HTTP integration service settings.
INTEGRATION_API_HOST=127.0.0.1
INTEGRATION_API_PORT=8001
INTEGRATION_API_DEBUG=false

SHIPPO_API_KEY=shippo_test_your_key_here
SHIPPO_BASE_URL=https://api.goshippo.com
SHIPPO_TIMEOUT_SECONDS=30
# Optional retry policy: total attempts, exponential base delay, Retry-After cap.
SHIPPO_MAX_ATTEMPTS=3
SHIPPO_BACKOFF_SECONDS=0.5
SHIPPO_MAX_RETRY_AFTER_SECONDS=30

# Optional Docker Compose host ports and backend integration timeouts.
FRONTEND_HOST_PORT=8080
BACKEND_HOST_PORT=5001
SHIPPO_INTEGRATION_CONNECT_TIMEOUT_SECONDS=3.05
SHIPPO_INTEGRATION_READ_TIMEOUT_SECONDS=30